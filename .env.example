# Solana devnet — public endpoints, no API key required
SOLANA_RPC=https://api.devnet.solana.com
SOLANA_WS=wss://api.devnet.solana.com

# Postgres (compose-internal)
DATABASE_URL=postgres://sky:sky@postgres:5432/collective_sky

# Indexer behaviour
LIVE=1                    # 0 disables the WebSocket tail (sweep only)
SWEEP_INTERVAL_MS=300000  # re-check every known owner every 5 min
MAX_TX_PER_MIN=120        # rate guard on transaction inspection
SWEEP_BATCH=200           # owners swept per cycle, oldest first; bounds the cost
                          # of a watchlist anyone can grow by minting to new wallets

# Model tags — override if a tag is unavailable in your Docker Model Runner
CHAT_MODEL_TAG=ai/qwen3
EMBED_MODEL_TAG=ai/qwen3-embedding:0.6B-F16

# Narrator
NARRATE_INTERVAL_MS=900000  # 15 min
REPORT_WINDOW_HOURS=24
MIN_MESSAGES_FOR_THEMES=8
